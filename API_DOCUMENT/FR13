openapi: 3.0.0

info:
  title: FR13 - Phản hồi nhận chuyến
  version: 1.0.0

servers:
  - url: http://localhost:8080/api/v1

tags:
  - name: Driver Assignment

paths:

  /rides/{rideId}/driver-response:
    post:
      summary: Ghi nhận phản hồi nhận chuyến của Driver
      operationId: ghiNhanPhanHoiDriver
      tags:
        - Driver Assignment
      security:
        - bearerAuth: []

      parameters:
        - name: rideId
          in: path
          required: true
          schema:
            type: integer
            format: int64

      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/DriverResponseRequest'

      responses:
        '200':
          description: Ghi nhận phản hồi thành công
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/DriverAssignment'

        '400':
          description: Phản hồi không hợp lệ
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

        '401':
          description: Người dùng chưa được xác thực
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

components:

  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT

  schemas:

    DriverResponseRequest:
      type: object
      properties:
        response:
          type: string
          enum:
            - accepted
            - rejected
      required:
        - response

    DriverAssignment:
      type: object
      properties:
        rideId:
          type: integer
          format: int64
        driverId:
          type: integer
          format: int64
          nullable: true
        status:
          type: string
          enum:
            - searching
            - assigned
            - rejected
            - no_response
            - no_driver_available

    Error:
      type: object
      properties:
        error_code:
          type: string
        message:
          type: string
      required:
        - error_code
        - message
