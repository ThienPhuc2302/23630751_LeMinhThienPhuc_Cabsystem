openapi: 3.0.0

info:
  title: FR23 - Thanh toán bằng tiền mặt
  version: 1.0.0

servers:
  - url: http://localhost:8080/api/v1

tags:
  - name: Payment

paths:

  /rides/{rideId}/cash-payment/confirm:
    patch:
      summary: Driver xác nhận đã nhận tiền mặt từ Customer
      operationId: xacNhanThanhToanTienMat
      tags:
        - Payment
      security:
        - bearerAuth: []

      parameters:
        - name: rideId
          in: path
          required: true
          schema:
            type: integer
            format: int64

      responses:
        '200':
          description: Xác nhận thanh toán tiền mặt thành công
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Payment'

        '400':
          description: Chuyến đi không sử dụng phương thức thanh toán tiền mặt hoặc chưa đủ điều kiện xác nhận
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

        '403':
          description: Driver không có quyền xác nhận thanh toán của chuyến đi này
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

        '404':
          description: Không tìm thấy chuyến đi
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

        '500':
          description: Không thể cập nhật trạng thái thanh toán
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

components:

  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT

  schemas:

    Payment:
      type: object
      properties:
        rideId:
          type: integer
          format: int64
        customerId:
          type: integer
          format: int64
        driverId:
          type: integer
          format: int64
        amount:
          type: number
          format: double
        paymentMethod:
          type: string
          enum:
            - cash
            - electronic
        paymentStatus:
          type: string
          enum:
            - pending
            - success
            - failed
        confirmedAt:
          type: string
          format: date-time
          nullable: true

    Error:
      type: object
      properties:
        error_code:
          type: string
        message:
          type: string
      required:
        - error_code
        - message
