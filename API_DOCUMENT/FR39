openapi: 3.0.0

info:
  title: FR39 - Bảo vệ dữ liệu
  version: 1.0.0

servers:
  - url: http://localhost:8080/api/v1

tags:
  - name: Security

paths:

  /auth/me:
    get:
      summary: Truy cập thông tin người dùng sau khi xác thực
      operationId: baoVeThongTinNguoiDung
      tags:
        - Security
      security:
        - bearerAuth: []

      responses:
        '200':
          description: Thông tin người dùng được bảo vệ bằng xác thực
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/User'

        '401':
          description: Truy cập trái phép
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

  /auth/permissions:
    get:
      summary: Kiểm soát quyền truy cập dữ liệu
      operationId: baoVeDuLieuTheoQuyen
      tags:
        - Security
      security:
        - bearerAuth: []

      responses:
        '200':
          description: Quyền truy cập của người dùng
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PermissionResponse'

        '403':
          description: Truy cập dữ liệu trái phép
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

components:

  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT

  schemas:

    User:
      type: object
      properties:
        id:
          type: integer
          format: int64
        username:
          type: string
        email:
          type: string
          format: email
        phone:
          type: string
        role:
          type: string
          enum:
            - customer
            - driver
            - operations_staff
        status:
          type: string
          enum:
            - active
            - inactive
            - locked
      required:
        - id
        - username
        - email
        - role
        - status

    PermissionResponse:
      type: object
      properties:
        userId:
          type: integer
          format: int64
        role:
          type: string
          enum:
            - customer
            - driver
            - operations_staff
        permissions:
          type: array
          items:
            type: string

    Error:
      type: object
      properties:
        error_code:
          type: string
        message:
          type: string
      required:
        - error_code
        - message
