openapi: 3.0.0

info:
  title: FR22 - Lựa chọn phương thức thanh toán
  version: 1.0.0

servers:
  - url: http://localhost:8080/api/v1

tags:
  - name: Payment

paths:

  /rides/{rideId}/payment-method:
    patch:
      summary: Lựa chọn phương thức thanh toán cho chuyến đi
      operationId: chonPhuongThucThanhToan
      tags:
        - Payment
      security:
        - bearerAuth: []

      parameters:
        - name: rideId
          in: path
          required: true
          schema:
            type: integer
            format: int64

      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PaymentMethodRequest'

      responses:
        '200':
          description: Lựa chọn phương thức thanh toán thành công
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Payment'

        '400':
          description: Phương thức thanh toán không hợp lệ
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

        '403':
          description: Customer không có quyền thay đổi phương thức thanh toán của chuyến đi này
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

        '404':
          description: Không tìm thấy chuyến đi
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

components:

  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT

  schemas:

    PaymentMethodRequest:
      type: object
      properties:
        paymentMethod:
          type: string
          enum:
            - cash
            - electronic
      required:
        - paymentMethod

    Payment:
      type: object
      properties:
        rideId:
          type: integer
          format: int64
        customerId:
          type: integer
          format: int64
        amount:
          type: number
          format: double
        paymentMethod:
          type: string
          enum:
            - cash
            - electronic
        paymentStatus:
          type: string
          enum:
            - pending
            - success
            - failed

    Error:
      type: object
      properties:
        error_code:
          type: string
        message:
          type: string
      required:
        - error_code
        - message
