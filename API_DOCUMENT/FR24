openapi: 3.0.0

info:
  title: FR24 - Cập nhật trạng thái thanh toán
  version: 1.0.0

servers:
  - url: http://localhost:8080/api/v1

tags:
  - name: Payment

paths:

  /payments/{paymentId}:
    get:
      summary: Xem trạng thái và kết quả thanh toán
      operationId: xemKetQuaThanhToan
      tags:
        - Payment
      security:
        - bearerAuth: []

      parameters:
        - name: paymentId
          in: path
          required: true
          schema:
            type: integer
            format: int64

      responses:
        '200':
          description: Trạng thái giao dịch
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Payment'

        '404':
          description: Không tìm thấy giao dịch
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

components:

  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT

  schemas:

    Payment:
      type: object
      properties:
        id:
          type: integer
          format: int64
        tripId:
          type: integer
          format: int64
        amount:
          type: number
          format: double
        paymentMethod:
          type: string
          enum:
            - cash
            - electronic
        status:
          type: string
          enum:
            - pending
            - processing
            - successful
            - failed
        transactionCode:
          type: string
          nullable: true
        paidAt:
          type: string
          format: date-time
          nullable: true

    Error:
      type: object
      properties:
        error_code:
          type: string
        message:
          type: string
      required:
        - error_code
        - message
