openapi: 3.0.0

info:
  title: FR24 - Thực hiện thanh toán điện tử
  version: 1.0.0

servers:
  - url: http://localhost:8080/api/v1

tags:
  - name: Payment

paths:

  /rides/{rideId}/electronic-payment:
    post:
      summary: Thực hiện thanh toán điện tử cho chuyến đi
      operationId: thucHienThanhToanDienTu
      tags:
        - Payment
      security:
        - bearerAuth: []

      parameters:
        - name: rideId
          in: path
          required: true
          schema:
            type: integer
            format: int64

      responses:
        '200':
          description: Thanh toán điện tử được xử lý thành công
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Payment'

        '400':
          description: Chuyến đi không sử dụng phương thức thanh toán điện tử hoặc dữ liệu không hợp lệ
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

        '403':
          description: Customer không có quyền thực hiện thanh toán cho chuyến đi này
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

        '404':
          description: Không tìm thấy chuyến đi
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

        '502':
          description: Không nhận được kết quả hợp lệ từ nhà cung cấp thanh toán
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

components:

  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT

  schemas:

    Payment:
      type: object
      properties:
        rideId:
          type: integer
          format: int64
        customerId:
          type: integer
          format: int64
        amount:
          type: number
          format: double
        paymentMethod:
          type: string
          enum:
            - cash
            - electronic
        paymentStatus:
          type: string
          enum:
            - pending
            - success
            - failed
        providerTransactionId:
          type: string
          nullable: true
        paidAt:
          type: string
          format: date-time
          nullable: true

    Error:
      type: object
      properties:
        error_code:
          type: string
        message:
          type: string
      required:
        - error_code
        - message
