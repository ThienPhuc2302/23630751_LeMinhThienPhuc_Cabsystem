openapi: 3.0.0

info:
  title: FR32 - Tra cứu giao dịch
  version: 1.0.0

servers:
  - url: http://localhost:8080/api/v1

tags:
  - name: Operations

paths:

  /operations/transactions:
    get:
      summary: Tra cứu thông tin và lịch sử giao dịch
      operationId: traCuuGiaoDich
      tags:
        - Operations
      security:
        - bearerAuth: []

      responses:
        '200':
          description: Danh sách giao dịch
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Payment'

        '403':
          description: Không có quyền truy cập
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

components:

  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT

  schemas:

    Payment:
      type: object
      properties:
        id:
          type: integer
          format: int64
        tripId:
          type: integer
          format: int64
        amount:
          type: number
          format: double
        paymentMethod:
          type: string
          enum:
            - cash
            - electronic
        status:
          type: string
          enum:
            - pending
            - processing
            - successful
            - failed
        transactionCode:
          type: string
          nullable: true
        paidAt:
          type: string
          format: date-time
          nullable: true

    Error:
      type: object
      properties:
        error_code:
          type: string
        message:
          type: string
      required:
        - error_code
        - message
