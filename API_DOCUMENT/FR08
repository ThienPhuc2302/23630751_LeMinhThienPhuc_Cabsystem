openapi: 3.0.0

info:
  title: FR08 - Nhập thông tin đặt xe
  version: 1.0.0

servers:
  - url: http://localhost:8080/api/v1

tags:
  - name: Ride Booking

paths:

  /rides:
    post:
      summary: Nhập thông tin yêu cầu đặt xe
      operationId: nhapThongTinDatXe
      tags:
        - Ride Booking
      security:
        - bearerAuth: []

      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/RideRequest'

      responses:
        '201':
          description: Đã tiếp nhận thông tin đặt xe
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Ride'

        '400':
          description: Thông tin đặt xe không hợp lệ
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

        '401':
          description: Người dùng chưa được xác thực
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

components:

  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT

  schemas:

    RideRequest:
      type: object
      properties:
        pickupLocation:
          type: string
        destination:
          type: string
        serviceType:
          type: string
          enum:
            - motorcycle
            - car
        estimatedDistance:
          type: number
          format: double
      required:
        - pickupLocation
        - destination
        - serviceType

    Ride:
      type: object
      properties:
        id:
          type: integer
          format: int64
        requestCode:
          type: string
        customerId:
          type: integer
          format: int64
        driverId:
          type: integer
          format: int64
          nullable: true
        vehicleId:
          type: integer
          format: int64
          nullable: true
        pickupLocation:
          type: string
        destination:
          type: string
        serviceType:
          type: string
        status:
          type: string
          enum:
            - requested
            - searching_driver
            - driver_assigned
            - in_progress
            - completed
            - cancelled
            - failed

    Error:
      type: object
      properties:
        error_code:
          type: string
        message:
          type: string
      required:
        - error_code
        - message
