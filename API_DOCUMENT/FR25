openapi: 3.0.0

info:
  title: FR25 - Thông báo kết quả và thử lại thanh toán điện tử
  version: 1.0.0

servers:
  - url: http://localhost:8080/api/v1

tags:
  - name: Payment

paths:

  /rides/{rideId}/payment-result:
    get:
      summary: Xem kết quả thanh toán của chuyến đi
      operationId: xemKetQuaThanhToan
      tags:
        - Payment
      security:
        - bearerAuth: []

      parameters:
        - name: rideId
          in: path
          required: true
          schema:
            type: integer
            format: int64

      responses:
        '200':
          description: Lấy kết quả thanh toán thành công
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Payment'

        '403':
          description: Customer không có quyền xem kết quả thanh toán của chuyến đi này
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

        '404':
          description: Không tìm thấy chuyến đi hoặc giao dịch thanh toán
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

  /rides/{rideId}/electronic-payment/retry:
    post:
      summary: Thử lại thanh toán điện tử khi giao dịch thất bại
      operationId: thuLaiThanhToanDienTu
      tags:
        - Payment
      security:
        - bearerAuth: []

      parameters:
        - name: rideId
          in: path
          required: true
          schema:
            type: integer
            format: int64

      responses:
        '200':
          description: Thử lại thanh toán điện tử thành công
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Payment'

        '400':
          description: Giao dịch không ở trạng thái thất bại hoặc không đủ điều kiện thử lại
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

        '403':
          description: Customer không có quyền thực hiện lại thanh toán cho chuyến đi này
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

        '404':
          description: Không tìm thấy chuyến đi hoặc giao dịch thanh toán
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

        '502':
          description: Không nhận được kết quả hợp lệ từ nhà cung cấp thanh toán
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

components:

  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT

  schemas:

    Payment:
      type: object
      properties:
        rideId:
          type: integer
          format: int64
        customerId:
          type: integer
          format: int64
        amount:
          type: number
          format: double
        paymentMethod:
          type: string
          enum:
            - cash
            - electronic
        paymentStatus:
          type: string
          enum:
            - pending
            - success
            - failed
        providerTransactionId:
          type: string
          nullable: true
        retryCount:
          type: integer
          example: 1
        paidAt:
          type: string
          format: date-time
          nullable: true

    Error:
      type: object
      properties:
        error_code:
          type: string
        message:
          type: string
      required:
        - error_code
        - message
